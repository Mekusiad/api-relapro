// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id           Int        @id @default(autoincrement())
  name         String
  username     String     @unique
  employeeRole String
  hireDate     DateTime
  password     String
  role         String // técnico, supervisor, admin
  orders       Order[]    @relation("Responsible")
  activity     Activity[]
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt
}

model Order {
  id                  Int       @id @default(autoincrement())
  numberOs            String    @unique
  client              String
  localService        String
  initialDescription  String
  status              String // aberta, em_andamento, finalizada
  previousInitialDate DateTime
  finishDate          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  responsibleTechnician   Employee   @relation("Responsible", fields: [responsibleTechnicianId], references: [id])
  responsibleTechnicianId Int
  activity                Activity[]
  photo                   Photo[]
}

model Activity {
  id          Int      @id @default(autoincrement())
  description String
  material    String
  dateHour    DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id])
  orderId     Int
  employee    Employee @relation(fields: [employeeId], references: [id])
  employeeId  Int
}

model Photo {
  id      Int    @id @default(autoincrement())
  url     String
  type    String // antes, depois, geral
  order   Order  @relation(fields: [orderId], references: [id])
  orderId Int
}
