// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// datasource db {
//   provider = "postgresql"
//   url      = env("DATABASE_URL")
// }

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db" // cria o banco local aqui
}

model Funcionario {
  id          Int      @id @default(autoincrement())
  nome        String
  matricula   Int      @unique
  usuario     String   @unique
  cargo       String
  admissao    DateTime
  senha       String
  nivelAcesso String // técnico, supervisor, admin
  supervisor  Ordem[]  @relation("SupervisorOrdem")
  tecnico     Ordem[]  @relation("TecnicoOrdem")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Ordem {
  id               Int       @id @default(autoincrement())
  numeroOs         String    @unique
  cliente          String
  nomeResponsavel  String
  contato          String
  email            String
  localServico     String
  descricaoInicial String
  status           String // aberta, em_andamento, finalizada
  previsaoInicio   DateTime
  previsaoTermino  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Supervisor: apenas um
  supervisor          Funcionario @relation("SupervisorOrdem", fields: [supervisorMatricula], references: [matricula])
  supervisorMatricula Int

  // Técnicos: vários
  tecnico Funcionario[] @relation("TecnicoOrdem")

  componente                Componente[]
  ensaioTrafoPotencia       EnsaioTrafoPotencia[]
  ensaioTrafoCorrente       EnsaioTrafoCorrente[]
  ensaioDisjuntor           EnsaioDisjuntor[]
  ensaioResistorAterramento EnsaioResistorAterramento[]
  malhaAterramento          MalhaAterramento[]
  ensaioChaveSeccionadora   EnsaioChaveSeccionadora[]
}

model Componente {
  id                 Int     @id @default(autoincrement())
  nomeEquipamento    String
  cliente            String
  tag                String?
  localizacao        String?
  modelo             String?
  fabricante         String?
  numeroSerie        String? @unique
  meioIsolante       String?
  anoFabricacao      Int?
  massaTotal         Float?
  potencia           String?
  tipoTensaoAt       String?
  tensaoAt           Float?
  tipoTensaoBt       String?
  tensaoBt           Float?
  volumeOleoIsolante Float?
  temperaturaEnsaio  Float?
  umidadeRelativaAr  Float?
  exatidao           Float?
  circuito           Float?
  tipoPressao        String?
  pressao            Float?

  ordem   Ordem  @relation(fields: [orderOs], references: [numeroOs])
  orderOs String

  // ensaioTrafoAlta EnsaioTrafoAlta[]
  // ensaioTrafoForca EnsaioTrafoForca[]
  ensaioTrafoPotencia       EnsaioTrafoPotencia[]
  ensaioTrafoCorrente       EnsaioTrafoCorrente[]
  ensaioDisjuntor           EnsaioDisjuntor[]
  ensaioResistorAterramento EnsaioResistorAterramento[]
}

model EnsaioTrafoPotencia {
  id Int @id @default(autoincrement())

  tapComutadorAt String
  tapComutadorBt String

  relacaoCalculadaAtBt Float
  relacaoMedida1       Float
  relacaoMedida2       Float
  relacaoMedida3       Float

  resistenciaOhmicaEnrolamentoAt1 Float
  resistenciaOhmicaEnrolamentoAt2 Float
  resistenciaOhmicaEnrolamentoAt3 Float

  resistenciaOhmicaEnrolamentoBt1 Float
  resistenciaOhmicaEnrolamentoBt2 Float
  resistenciaOhmicaEnrolamentoBt3 Float

  resistenciaIsolamentoAtxBt    Float
  resistenciaIsolamentoAtxMassa Float
  resistenciaIsolamentoBtxMassa Float

  observacao String

  protecaoTransformador1          String
  protecaoTransformador2          String
  protecaoTransformador3          String
  protecaoTransformador4          String
  protecaoTransformador5          String
  protecaoTransformador6          String
  protecaoTransformadorObservacao String

  ordem   Ordem  @relation(fields: [ordemOs], references: [numeroOs])
  ordemOs String

  dispositivo      Componente @relation(fields: [dispositivoSerie], references: [numeroSerie])
  dispositivoSerie String

  equipamentoUsado Equipamento[]
}

model EnsaioTrafoCorrente {
  id Int @id @default(autoincrement())

  relacaoMedida                Float
  relacaoOhmica                Float
  resistenciaIsolamentoPxS     Int
  resistenciaIsolamentoPxMassa Int
  resistenciaIsolamentoSxMassa Int
  observacao                   String

  ordem   Ordem  @relation(fields: [ordemOs], references: [numeroOs])
  ordemOs String

  dispositivo      Componente @relation(fields: [dispositivoSerie], references: [numeroSerie])
  dispositivoSerie String

  equipamentoUsado Equipamento[]
}

model EnsaioDisjuntor {
  id Int @id @default(autoincrement())

  resistenciaContatoDisjuntorFechadoA Float
  resistenciaContatoDisjuntorFechadoB Float
  resistenciaContatoDisjuntorFechadoC Float
  resistenciaContatoDisjuntorAbertoA  Float
  resistenciaContatoDisjuntorAbertoB  Float
  resistenciaContatoDisjuntorAbertoC  Float
  resistenciaIsolamentoAxMassa        Float
  resistenciaIsolamentoBxMassa        Float
  resistenciaIsolamentoCxMassa        Float

  servico1 Boolean
  servico2 Boolean
  servico3 Boolean
  servico4 Boolean

  observacao String

  ordem   Ordem  @relation(fields: [ordemOs], references: [numeroOs])
  ordemOs String

  dispositivo      Componente @relation(fields: [dispositivoSerie], references: [numeroSerie])
  dispositivoSerie String

  equipamentoUsado Equipamento[]
}

model MalhaAterramento {
  id Int @id @default(autoincrement())

  resistenciaMalhaAterramento String?
  servico1                    String?
  servico2                    String?
  servico3                    String?
  observacao                  String?

  ordem   Ordem  @relation(fields: [ordemOs], references: [numeroOs])
  ordemOs String

  equipamentoUsado Equipamento[]
}

model EnsaioResistorAterramento {
  id Int @id @default(autoincrement())

  resistenciaOhmicaMedida Float
  resistenciaIsolamento   Float
  observacao              String

  ordem   Ordem  @relation(fields: [ordemOs], references: [numeroOs])
  ordemOs String

  dispositivo      Componente @relation(fields: [dispositivoSerie], references: [numeroSerie])
  dispositivoSerie String

  equipamentoUsado Equipamento[]
}

model EnsaioChaveSeccionadora {
  id Int @id @default(autoincrement())

  resistenciaContatoA    Float
  resistenciaContatoB    Float
  resistenciaContatoC    Float
  resistenciaIsolamentoA Float
  resistenciaIsolamentoB Float
  resistenciaIsolamentoC Float
  observacao             String

  equipamentoUsado Equipamento[]

  ordem   Ordem  @relation(fields: [ordemOs], references: [numeroOs])
  ordemOs String
}

model Equipamento {
  id          Int    @id @default(autoincrement())
  nome        String
  descricao   String
  modelo      String
  numeroSerie String @unique

  // ensaioTrafoAlta      EnsaioTrafoAlta @relation(fields: [ensaioTrafoAlta], references: [id])
  // ensaioTrafoAltaId Int

  ensaioTrafoPotencia   EnsaioTrafoPotencia @relation(fields: [ensaioTrafoPotenciaId], references: [id])
  ensaioTrafoPotenciaId Int

  // ensaioTrafoForca      EnsaioTrafoForca @relation(fields: [ensaioTrafoForcaId], references: [id])
  // ensaioTrafoForcaId Int

  ensaioTrafoCorrente   EnsaioTrafoCorrente @relation(fields: [ensaioTrafoCorrenteId], references: [id])
  ensaioTrafoCorrenteId Int

  ensaioDisjuntor   EnsaioDisjuntor @relation(fields: [ensaioDisjuntorId], references: [id])
  ensaioDisjuntorId Int

  malhaAterramento      MalhaAterramento @relation(fields: [malhaAterramentoSerie], references: [id])
  malhaAterramentoSerie Int

  ensaioResistor              EnsaioResistorAterramento @relation(fields: [EnsaioResistorAterramentoId], references: [id])
  EnsaioResistorAterramentoId Int

  ensaioChaveSeccionadora   EnsaioChaveSeccionadora @relation(fields: [ensaioChaveSeccionadoraId], references: [id])
  ensaioChaveSeccionadoraId Int
}
