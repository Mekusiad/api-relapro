// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}
  // output   = "../src/generated/prisma"

// datasource db {
//   provider = "postgresql"
//   url      = env("DATABASE_URL")
// }

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db" // cria o banco local aqui
}

model Funcionario {
  id          Int         @id @default(autoincrement())
  nome        String
  matricula   String      @unique
  usuario     String      @unique
  cargo       String
  admissao    DateTime    @default(now())
  senha       String
  nivelAcesso NivelAcesso
  supervisor  Ordem[]     @relation("SupervisorOrdem")
  tecnico     Ordem[]     @relation("TecnicoOrdem")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  foto Foto[]
  ensaio  Ensaio[]
}

enum NivelAcesso {
  ADMIN
  SUPERVISOR
  TECNICO
}

model Ordem {
  id               Int         @id @default(autoincrement())
  numeroOs         String      @unique
  numeroOrcamento  String      @unique
  cliente          String
  nomeResponsavel  String
  contato          String
  email            String
  localServico     String
  descricaoInicial String
  tipoServico      TipoServico
  status           StatusOrdem
  previsaoInicio   DateTime
  observacoes      String?
  conclusao        String?
  recomendacao     String?
  previsaoTermino  DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Supervisor: apenas um
  supervisor          Funcionario? @relation("SupervisorOrdem", fields: [supervisorMatricula], references: [matricula], onDelete: Cascade)
  supervisorMatricula String?

  // Técnicos: vários
  tecnico Funcionario[] @relation("TecnicoOrdem")

  subestacoes Subestacao[]
  foto Foto[]
}

enum TipoServico {
 MANUTENCAO_PREVENTIVA
 MANUTENCAO_CORRETIVA
 MANUTENCAO_PREDITIVA
 ENSAIO_EPI
 INSPECAO
 INSTALACAO
 OUTROS
 }

enum StatusOrdem {
  ABERTA
  EM_ANDAMENTO
  AGUARDANDO_PECAS
  FINALIZADA
}

model Foto {
  id        Int      @id @default(autoincrement())
  descricao String
  fotoUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordem   Ordem  @relation(fields: [ordemOs], references: [numeroOs], onDelete: Cascade)
  ordemOs String

  componente   Componente @relation(fields: [componenteId], references: [id])
  componenteId Int

  subestacao   Subestacao @relation(fields: [subestacaoId], references: [id])
  subestacaoId Int

  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])
  funcionarioId Int

  ensaio   Ensaio @relation(fields: [ensaioId], references: [id])
  ensaioId Int
  

  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id])
  equipamentoId Int

  recomendacao   Recomendacao @relation(fields: [recomendacaoId], references: [id])
  recomendacaoId Int
}

model Subestacao {
  id   Int    @id @default(autoincrement())
  nome String // Nome ou código da subestação
  observacoesTecnicasSubestacao   String?

  ordem   Ordem  @relation(fields: [ordemOs], references: [numeroOs], onDelete: Cascade)
  ordemOs String
  observacao String?

  componentes             Componente[] // Subestação possui vários componentes
  recomendacao            Recomendacao[]
  foto                    Foto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Componente {
  id                 Int            @id @default(autoincrement())
  nomeEquipamento    String
  cliente            String?
  tag                String?
  identificacao      String?
  localizacao        String?
  tipo               TipoComponente
  modelo             String?
  fabricante         String?
  numeroSerie        String?
  quantidade         Int      @default(1)
  meioIsolante       String?
  anoFabricacao      Int?
  massaTotal         Float?
  potencia           String?
  correnteNominal    Float?
  correntePrimario   Float?
  correnteSecundario Float?
  tensaoNominal      Float?
  tipoTensaoAt       TipoTensao?
  tensaoAt           Float?
  tipoTensaoBt       TipoTensao?
  tensaoBt           String?
  volumeOleoIsolante Float?
  temperaturaEnsaio  Float?
  impedancia         Float?
  frequencia         Float?
  umidadeRelativaAr  Float?
  exatidao           Float?
  circuito           Float?
  tipoPressao        TipoPressao?
  pressao            Float?
  bitolaCabo         Float?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  subestacao   Subestacao @relation(fields: [subestacaoId], references: [id], onDelete: Cascade)
  subestacaoId Int

  ensaio Ensaio[]
  foto                      Foto[]
  recomendacao              Recomendacao[]

  
}

enum TipoTensao {
X
Y
NA
}

enum TipoPressao {
GAS
OLEO
}

enum TipoComponente {
  TRAFO_ALTA
  TRAFO_MEDIA
  TRAFO_CORRENTE
  TRAFO_POTENCIA
  TRAFO_FORCA
  DISJUNTOR_ALTA
  DISJUNTOR_MEDIA
  DISJUNTOR_BAIXA
  RESISTOR
  CHAVE_SECCIONADORA
  MALHA
  BUCHA
  CABOMUFLA
}

model Equipamento {
  id          Int    @id @default(autoincrement())
  nome        String
  descricao   String
  modelo      String
  numeroSerie String @unique


  ensaio   Ensaio[]
  foto Foto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LogAtividade {
  id            Int      @id @default(autoincrement())
  acao          String // EXCLUIR, CRIAR, ATUALIZAR
  entidade      String // funcionario, ordem, componente etc.
  dadosAfetados Json // snapshot do que foi afetado
  feitoPor      Int // matrícula de quem realizou a ação
  criadoEm      DateTime @default(now())
}

model Recomendacao {
  id Int @id @default(autoincrement())

  componente   Componente? @relation(fields: [componenteId], references: [id])
  componenteId Int
  observacao   String

  subestacao   Subestacao @relation(fields: [subestacaoId], references: [id], onDelete: Cascade)
  subestacaoId Int

  foto      Foto[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Ensaio {
  id                      Int      @id @default(autoincrement())
  tipo                    TipoComponente
  dados                   Json
  dataEnsaio              DateTime?
  engenheiroResponsavel   String?
  equipamentosUtilizados  Json? // Vamos manter este como JSON para simplificar

  // --- RELAÇÕES CORRIGIDAS ---
  componente              Componente @relation(fields: [componenteId], references: [id], onDelete: Cascade)
  componenteId            Int

  // Relação correta com Funcionário
  responsavel             Funcionario? @relation(fields: [responsavelMatricula], references: [matricula])
  responsavelMatricula    String? // CORRIGIDO: para corresponder ao tipo em Funcionario


  equipamento   Equipamento[]
  fotos                   Foto[] // A sua relação com Foto (já estava correta)
  
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([tipo, componenteId])
}