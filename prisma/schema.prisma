generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// datasource db {
//   provider = "postgresql"
//   url      = env("DATABASE_URL")
// }

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db" // cria o banco local aqui
}

model Funcionario {
  id          Int      @id @default(autoincrement())
  nome        String
  matricula   Int      @unique
  usuario     String   @unique
  cargo       String
  admissao    DateTime
  senha       String
  nivelAcesso String // técnico, supervisor, admin
  supervisor  Ordem[]  @relation("SupervisorOrdem")
  tecnico     Ordem[]  @relation("TecnicoOrdem")
  // atividade         Atividade[]
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model Ordem {
  id               Int       @id @default(autoincrement())
  numeroOs         String    @unique
  cliente          String
  nomeResponsavel  String
  contato          String
  email            String
  localServico     String
  descricaoInicial String
  status           String // aberta, em_andamento, finalizada
  previsaoInicio   DateTime
  previsaoTermino  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Supervisor: apenas um
  supervisor          Funcionario @relation("SupervisorOrdem", fields: [supervisorMatricula], references: [matricula])
  supervisorMatricula Int

  // Técnicos: vários
  tecnico Funcionario[] @relation("TecnicoOrdem")

  disjuntor Disjuntor[]
  // atividade      Atividade[]

  transformadorAlta     TransformadorAlta[]
  transformadorForca    TransformadorForca[]
  transformadorPotencia TransformadorPotencia[]
  transformadorCorrente TransformadorCorrente[]
  malhaAterramento      MalhaAterramento[]
  groundingResistor     ResistorAterramento[]
  disconnectorSwitch    ChaveSeccionadora[]
}

model TransformadorAlta {
  id                 Int    @id @default(autoincrement())
  nomeEquipamento    String
  cliente            String
  local              String
  tipo               String
  fabricante         String
  numeroSerie        String @unique
  meioIsolante       String
  anoFabricacao      Int
  massaTotal         Float
  potencia           String
  tipoTensaoAt       String
  tensaoAt           Float
  tipoTensaoBt       String
  tensaoBt           Float
  volumeOleoIsolante Float
  temperaturaEnsaio  Float
  umidadeRelativaAr  Float

  equipamento Equipamento[]

  ordem   Ordem  @relation(fields: [orderOs], references: [numeroOs])
  orderOs String
}

model TransformadorPotencia {
  id                 Int    @id @default(autoincrement())
  nomeEquipamento    String
  cliente            String
  local              String
  tipo               String
  fabricante         String
  numeroSerie        String @unique
  meioIsolante       String
  anoFabricacao      Int
  massaTotal         Float
  potencia           String
  tipoTensaoAt       String
  tensaoAt           Float
  tipoTensaoBt       String
  tensaoBt           Float
  volumeOleoIsolante Float
  temperaturaEnsaio  Float
  umidadeRelativaAr  Float

  tapComutadorAt String
  tapComutadorBt String

  relacaoCalculadaAtBt Float
  relacaoMedida1       Float
  relacaoMedida2       Float
  relacaoMedida3       Float

  resistenciaOhmicaEnrolamentoAt1 Float
  resistenciaOhmicaEnrolamentoAt2 Float
  resistenciaOhmicaEnrolamentoAt3 Float

  resistenciaOhmicaEnrolamentoBt1 Float
  resistenciaOhmicaEnrolamentoBt2 Float
  resistenciaOhmicaEnrolamentoBt3 Float

  resistenciaIsolamentoAtBt    Float
  resistenciaIsolamentoAtMassa Float
  resistenciaIsolamentoBtMassa Float

  observacao String

  protecaoTransformador1          Boolean
  protecaoTransformador2          Boolean
  protecaoTransformador3          Boolean
  protecaoTransformador4          Boolean
  protecaoTransformador5          Boolean
  protecaoTransformador6          Boolean
  protecaoTransformadorObservacao String

  ordem   Ordem  @relation(fields: [ordemOs], references: [numeroOs])
  ordemOs String

  equipamentoUsado Equipamento[]
}

model TransformadorForca {
  id                 Int    @id @default(autoincrement())
  nomeEquipamento    String
  cliente            String
  local              String
  tipo               String
  fabricante         String
  numeroSerie        String @unique
  meioIsolante       String
  anoFabricacao      Int
  massaTotal         Float
  potencia           String
  tipoTensaoAt       String
  tensaoAt           Float
  tipoTensaoBt       String
  tensaoBt           Float
  volumeOleoIsolante Float
  temperaturaEnsaio  Float
  umidadeRelativaAr  Float

  equipamento Equipamento[]

  ordem   Ordem  @relation(fields: [ordemOs], references: [numeroOs])
  ordemOs String
}

model TransformadorCorrente {
  id                 Int    @id @default(autoincrement())
  nomeEquipamento    String
  cliente            String
  local              String
  tipo               String
  fabricante         String
  numeroSerie        String @unique
  meioIsolante       String
  anoFabricacao      Int
  massaTotal         Float
  potencia           String
  tipoTensaoAt       String
  tensaoAt           Float
  tipoTensaoBt       String
  tensaoBt           Float
  volumeOleoIsolante Float
  temperaturaEnsaio  Float
  umidadeRelativaAr  Float
  exatidao           String

  relacaoMedida                Float
  relacaoOhmica                Float
  resistenciaIsolamentoPxS     Int
  resistenciaIsolamentoPxMassa Int
  resistenciaIsolamentoSxMassa Int
  observacao                   String

  ordem   Ordem  @relation(fields: [ordemOs], references: [numeroOs])
  ordemOs String

  equipamentoUsado Equipamento[]
}

model Disjuntor {
  id                Int    @id @default(autoincrement())
  nomeEquipamento   String
  cliente           String
  localizacao       String
  tipo              String
  fabricante        String
  numeroSerie       String @unique
  meioIsolante      String
  tensaoNominal     Float
  correnteNominal   Float
  temperaturaEnsaio Float
  umidadeRelativaAr Float
  tipoPressao       String
  pressao           Float

  resistenciaContatoDisjuntorFechadoA Float
  resistenciaContatoDisjuntorFechadoB Float
  resistenciaContatoDisjuntorFechadoC Float
  resistenciaContatoDisjuntorAbertoA  Float
  resistenciaContatoDisjuntorAbertoB  Float
  resistenciaContatoDisjuntorAbertoC  Float
  resistenciaIsolamentoA              Float
  resistenciaIsolamentoB              Float
  resistenciaIsolamentoC              Float

  servico1 Boolean
  servico2 Boolean
  servico3 Boolean
  servico4 Boolean

  observacao String

  ordem   Ordem  @relation(fields: [ordemOs], references: [numeroOs])
  ordemOs String

  equipamentoUsado Equipamento[]
}

model MalhaAterramento {
  id          Int     @id @default(autoincrement())
  cliente     String
  localizacao String
  resistencia String
  servico1    Boolean
  servico2    Boolean
  observacao  String

  ordem   Ordem  @relation(fields: [ordemOs], references: [numeroOs])
  ordemOs String

  equipamentoUsado Equipamento[]
}

model ResistorAterramento {
  id                Int    @id @default(autoincrement())
  nomeEquipamento   String
  cliente           String
  localizacao       String
  tag               String
  modelo            String
  anoFabricacao     Int
  fabricante        String
  numeroSerie       String @unique
  tensao            Int
  correnteNominal   Float
  temperaturaEnsaio Float
  umidadeRelativaAr Float
  frequencia        Float
  massaTotal        Float

  resistenciaOhmicaMedida Float
  resistenciaIsolamento   Float
  observacao              String

  ordem   Ordem  @relation(fields: [ordemOs], references: [numeroOs])
  ordemOs String

  equipamentoUsado Equipamento[]
}

model ChaveSeccionadora {
  id                Int    @id @default(autoincrement())
  nomeEquipamento   String
  cliente           String
  localizacao       String
  identificacao     String
  tipo              String
  fabricante        String
  numeroSerie       String @unique
  tensaoNominal     Float
  correnteNominal   Float
  temperaturaEnsaio Float
  umidadeRelativaAr Float

  resistenciaContatoA    Float
  resistenciaContatoB    Float
  resistenciaContatoC    Float
  resistenciaIsolamentoA Float
  resistenciaIsolamentoB Float
  resistenciaIsolamentoC Float
  observacao             String

  equipamentoUsado Equipamento[]

  ordem   Ordem  @relation(fields: [ordemOs], references: [numeroOs])
  ordemOs String
}

model Equipamento {
  id          Int    @id @default(autoincrement())
  nome        String
  descricao   String
  modelo      String
  numeroSerie String @unique

  transformadorAlta      TransformadorAlta @relation(fields: [transformadorAltaSerie], references: [numeroSerie])
  transformadorAltaSerie String

  transformadorPotencia      TransformadorPotencia @relation(fields: [transformadorPotenciaSerie], references: [numeroSerie])
  transformadorPotenciaSerie String

  transformadorForca      TransformadorForca @relation(fields: [transformadorForcaSerie], references: [numeroSerie])
  transformadorForcaSerie String

  transformadorCorrente      TransformadorCorrente @relation(fields: [transformadorCorrenteSerie], references: [numeroSerie])
  transformadorCorrenteSerie String

  disjuntor      Disjuntor @relation(fields: [disjuntorSerie], references: [numeroSerie])
  disjuntorSerie String

  malhaAterramento      MalhaAterramento @relation(fields: [malhaAterramentoSerie], references: [id])
  malhaAterramentoSerie Int

  resistorAterramento      ResistorAterramento @relation(fields: [resistorAterramentoSerie], references: [numeroSerie])
  resistorAterramentoSerie String

  chaveSeccionadora      ChaveSeccionadora @relation(fields: [chaveSeccionadoraSerie], references: [numeroSerie])
  chaveSeccionadoraSerie String
}
