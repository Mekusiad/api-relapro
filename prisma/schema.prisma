generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

// datasource db {
//   provider = "postgresql"
//   url      = env("DATABASE_URL")
// }

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db" // cria o banco local aqui
}

model Funcionario {
  id          Int         @id @default(autoincrement())
  nome        String
  matricula   Int         @unique
  usuario     String      @unique
  cargo       String
  admissao    DateTime
  senha       String
  nivelAcesso NivelAcesso
  supervisor  Ordem[]     @relation("SupervisorOrdem")
  tecnico     Ordem[]     @relation("TecnicoOrdem")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  foto Foto[]
}

enum NivelAcesso {
  ADMIN
  SUPERVISOR
  TECNICO
}

model Ordem {
  id               Int         @id @default(autoincrement())
  numeroOs         String      @unique
  numeroOrcamento  String      @unique
  cliente          String
  nomeResponsavel  String
  contato          String
  email            String
  localServico     String
  descricaoInicial String
  status           StatusOrdem
  previsaoInicio   DateTime
  previsaoTermino  DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Supervisor: apenas um
  supervisor          Funcionario? @relation("SupervisorOrdem", fields: [supervisorMatricula], references: [matricula], onDelete: Cascade)
  supervisorMatricula Int?

  // Técnicos: vários
  tecnico Funcionario[] @relation("TecnicoOrdem")

  subestacoes Subestacao[]
}

enum StatusOrdem {
  ABERTA
  EM_ANDAMENTO
  FINALIZADA
}

model Foto {
  id        Int      @id @default(autoincrement())
  descricao String
  fotoUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  componente   Componente @relation(fields: [componenteId], references: [id])
  componenteId Int

  subestacao   Subestacao @relation(fields: [subestacaoId], references: [id])
  subestacaoId Int

  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])
  funcionarioId Int

  ensaio   Ensaio @relation(fields: [ensaioId], references: [id])
  ensaioId Int
  

  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id])
  equipamentoId Int

  recomendacao   Recomendacao @relation(fields: [recomendacaoId], references: [id])
  recomendacaoId Int
}

model Subestacao {
  id   Int    @id @default(autoincrement())
  nome String // Nome ou código da subestação

  ordem   Ordem  @relation(fields: [ordemOs], references: [numeroOs], onDelete: Cascade)
  ordemOs String

  componentes             Componente[] // Subestação possui vários componentes
  recomendacao            Recomendacao[]
  foto                    Foto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Componente {
  id                 Int            @id @default(autoincrement())
  nomeEquipamento    String
  cliente            String?
  tag                String?
  localizacao        String?
  tipo               TipoComponente
  modelo             String?
  fabricante         String?
  numeroSerie        String?
  meioIsolante       String?
  anoFabricacao      Int?
  massaTotal         Float?
  potencia           String?
  tipoTensaoAt       String?
  tensaoAt           Float?
  tipoTensaoBt       String?
  tensaoBt           Float?
  volumeOleoIsolante Float?
  temperaturaEnsaio  Float?
  umidadeRelativaAr  Float?
  exatidao           Float?
  circuito           Float?
  tipoPressao        String?
  pressao            Float?
  bitolaCabo         Float?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  subestacao   Subestacao @relation(fields: [subestacaoId], references: [id], onDelete: Cascade)
  subestacaoId Int

  ensaio Ensaio[]
  foto                      Foto[]
  recomendacao              Recomendacao[]

  @@unique([numeroSerie])
}

enum TipoComponente {
  TRAFO_ALTA
  TRAFO_MEDIA
  TRAFO_CORRENTE
  TRAFO_POTENCIA
  TRAFO_FORCA
  DISJUNTOR_ALTA
  DISJUNTOR_MEDIA
  DISJUNTOR_BAIXA
  RESISTOR
  CHAVE_SECCIONADORA
  MALHA
  BUCHA
  CABOMUFLA
}

model Equipamento {
  id          Int    @id @default(autoincrement())
  nome        String
  descricao   String
  modelo      String
  numeroSerie String @unique


  ensaio   Ensaio[]
  foto Foto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LogAtividade {
  id            Int      @id @default(autoincrement())
  acao          String // EXCLUIR, CRIAR, ATUALIZAR
  entidade      String // funcionario, ordem, componente etc.
  dadosAfetados Json // snapshot do que foi afetado
  feitoPor      Int // matrícula de quem realizou a ação
  criadoEm      DateTime @default(now())
}

model Recomendacao {
  id Int @id @default(autoincrement())

  componente   Componente? @relation(fields: [componenteId], references: [id])
  componenteId Int
  observacao   String

  subestacao   Subestacao @relation(fields: [subestacaoId], references: [id], onDelete: Cascade)
  subestacaoId Int

  foto      Foto[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Ensaio {
  id           Int          @id @default(autoincrement())
  tipo         TipoComponente
  dados        Json
  componente   Componente?  @relation(fields: [componenteId], references: [id], onDelete: Cascade)
  componenteId Int?

  responsavelMatricula Int

  equipamentoUsado Equipamento[]
  fotos       Foto[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([tipo, componenteId])
}