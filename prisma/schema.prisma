// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// datasource db {
//   provider = "postgresql"
//   url      = env("DATABASE_URL")
// }

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db" // cria o banco local aqui
}

model Funcionario {
  id          Int         @id @default(autoincrement())
  nome        String
  matricula   Int         @unique
  usuario     String      @unique
  cargo       String
  admissao    DateTime
  senha       String
  nivelAcesso NivelAcesso
  supervisor  Ordem[]     @relation("SupervisorOrdem")
  tecnico     Ordem[]     @relation("TecnicoOrdem")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

enum NivelAcesso {
  ADMIN
  SUPERVISOR
  TECNICO
}

model Ordem {
  id               Int         @id @default(autoincrement())
  numeroOs         String      @unique
  cliente          String
  nomeResponsavel  String
  contato          String
  email            String
  localServico     String
  descricaoInicial String
  status           StatusOrdem
  previsaoInicio   DateTime
  previsaoTermino  DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Supervisor: apenas um
  supervisor          Funcionario? @relation("SupervisorOrdem", fields: [supervisorMatricula], references: [matricula], onDelete: Cascade)
  supervisorMatricula Int?

  // Técnicos: vários
  tecnico Funcionario[] @relation("TecnicoOrdem")

  subestacoes Subestacao[]
}

enum StatusOrdem {
  ABERTA
  EM_ANDAMENTO
  FINALIZADA
}

model Subestacao {
  id          Int    @id @default(autoincrement())
  nome        String // Nome ou código da subestação

  ordem   Ordem  @relation(fields: [ordemOs], references: [numeroOs], onDelete: Cascade)
  ordemOs String

  componentes             Componente[] // Subestação possui vários componentes
  recomendacao            Recomendacao[]
  malhaAterramento        MalhaAterramento[]
  ensaioChaveSeccionadora EnsaioChaveSeccionadora[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Componente {
  id                 Int            @id @default(autoincrement())
  nomeEquipamento    String
  cliente            String?
  tag                String?
  localizacao        String?
  tipo               TipoComponente
  modelo             String?
  fabricante         String?
  numeroSerie        String?
  meioIsolante       String?
  anoFabricacao      Int?
  massaTotal         Float?
  potencia           String?
  tipoTensaoAt       String?
  tensaoAt           Float?
  tipoTensaoBt       String?
  tensaoBt           Float?
  volumeOleoIsolante Float?
  temperaturaEnsaio  Float?
  umidadeRelativaAr  Float?
  exatidao           Float?
  circuito           Float?
  tipoPressao        String?
  pressao            Float?
  bitolaCabo         Float?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  subestacao   Subestacao @relation(fields: [subestacaoId], references: [id], onDelete: Cascade)
  subestacaoId Int

  // ensaioTrafoAlta EnsaioTrafoAlta[]
  // ensaioTrafoForca EnsaioTrafoForca[]
  recomendacao              Recomendacao[]
  ensaioTrafoPotencia       EnsaioTrafoPotencia?
  ensaioTrafoCorrente       EnsaioTrafoCorrente?
  ensaioDisjuntor           EnsaioDisjuntor?
  ensaioResistorAterramento EnsaioResistorAterramento?
  medicaoCaboMufla          MedicaoCaboMufla?
  ensaioFPTrafo             EnsaioFPTrafo?
  ensaioFPBucha             EnsaioFPBucha?
  ensaioCorrenteExcitacao   EnsaioCorrenteExcitacao?

  @@unique([numeroSerie])
}

enum TipoComponente {
  TRAFO_ALTA
  TRAFO_MEDIA
  TRAFO_CORRENTE
  TRAFO_POTENCIA
  TRAFO_FORCA
  DISJUNTOR_ALTA
  DISJUNTOR_MEDIA
  DISJUNTOR_BAIXA
  RESISTOR
  CHAVE_SECCIONADORA
  MALHA
  BUCHA
  CABOMUFLA
}

model EnsaioTrafoPotencia {
  id Int @id @default(autoincrement())

  tapComutadorAt String
  tapComutadorBt String

  relacaoCalculadaAtBt Float
  relacaoMedida1       Float
  relacaoMedida2       Float
  relacaoMedida3       Float

  resistenciaOhmicaEnrolamentoAt1 Float @default(0)
  resistenciaOhmicaEnrolamentoAt2 Float
  resistenciaOhmicaEnrolamentoAt3 Float

  resistenciaOhmicaEnrolamentoBt1 Float
  resistenciaOhmicaEnrolamentoBt2 Float
  resistenciaOhmicaEnrolamentoBt3 Float

  resistenciaIsolamentoAtxBt    Float
  resistenciaIsolamentoAtxMassa Float
  resistenciaIsolamentoBtxMassa Float

  observacao String

  protecaoTransformador1          String
  protecaoTransformador2          String
  protecaoTransformador3          String
  protecaoTransformador4          String
  protecaoTransformador5          String
  protecaoTransformador6          String
  protecaoTransformadorObservacao String

  componente   Componente @relation(fields: [componenteID], references: [id], onDelete: Cascade)
  componenteID Int        @unique

  equipamentoUsado Equipamento[]

  responsavelEnsaioMatricula Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EnsaioTrafoCorrente {
  id Int @id @default(autoincrement())

  relacaoMedida                Float
  relacaoOhmica                Float
  resistenciaIsolamentoPxS     Int
  resistenciaIsolamentoPxMassa Int
  resistenciaIsolamentoSxMassa Int
  observacao                   String

  componente   Componente @relation(fields: [componenteID], references: [id], onDelete: Cascade)
  componenteID Int        @unique

  equipamentoUsado Equipamento[]

  responsavelEnsaioMatricula Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EnsaioDisjuntor {
  id Int @id @default(autoincrement())

  resistenciaContatoDisjuntorFechadoA Float
  resistenciaContatoDisjuntorFechadoB Float
  resistenciaContatoDisjuntorFechadoC Float
  resistenciaContatoDisjuntorAbertoA  Float
  resistenciaContatoDisjuntorAbertoB  Float
  resistenciaContatoDisjuntorAbertoC  Float
  resistenciaIsolamentoAxMassa        Float
  resistenciaIsolamentoBxMassa        Float
  resistenciaIsolamentoCxMassa        Float

  servico1 Boolean
  servico2 Boolean
  servico3 Boolean
  servico4 Boolean

  observacao String

  componente                 Componente    @relation(fields: [componenteID], references: [id], onDelete: Cascade)
  componenteID               Int           @unique
  responsavelEnsaioMatricula Int
  equipamentoUsado           Equipamento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EnsaioResistorAterramento {
  id Int @id @default(autoincrement())

  resistenciaOhmicaMedida Float
  resistenciaIsolamento   Float
  observacao              String

  componente   Componente @relation(fields: [componenteID], references: [id], onDelete: Cascade)
  componenteID Int        @unique

  equipamentoUsado           Equipamento[]
  responsavelEnsaioMatricula Int
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
}

model EnsaioChaveSeccionadora {
  id Int @id @default(autoincrement())

  resistenciaContatoA    Float
  resistenciaContatoB    Float
  resistenciaContatoC    Float
  resistenciaIsolamentoA Float
  resistenciaIsolamentoB Float
  resistenciaIsolamentoC Float
  observacao             String

  equipamentoUsado Equipamento[]

  subestacao                 Subestacao @relation(fields: [subestacaoId], references: [id], onDelete: Cascade)
  subestacaoId               Int
  responsavelEnsaioMatricula Int
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt
}

model MalhaAterramento {
  id Int @id @default(autoincrement())

  resistenciaMalhaAterramento String?
  servico1                    String?
  servico2                    String?
  servico3                    String?
  observacao                  String?

  subestacao   Subestacao @relation(fields: [subestacaoId], references: [id], onDelete: Cascade)
  subestacaoId Int

  equipamentoUsado           Equipamento[]
  responsavelEnsaioMatricula Int
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
}

model MedicaoCaboMufla {
  id                             Int @id @default(autoincrement())
  resistenciaIsolamentoX0xMassa  Int
  resistenciaIsolamentoX11xMassa Int
  resistenciaIsolamentoX12xMassa Int
  resistenciaIsolamentoX21xMassa Int
  resistenciaIsolamentoX22xMassa Int
  resistenciaIsolamentoX31xMassa Int
  resistenciaIsolamentoX32xMassa Int

  servico1 String
  servico2 String
  servico3 String

  observacao String

  componente   Componente @relation(fields: [componenteID], references: [id], onDelete: Cascade)
  componenteID Int        @unique

  equipamento Equipamento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EnsaioFPTrafo {
  id         Int   @id @default(autoincrement())
  correnteN1 Float
  correnteN2 Float
  correnteN3 Float
  correnteN4 Float
  correnteN5 Float
  correnteN6 Float

  wattsN1 Float
  wattsN2 Float
  wattsN3 Float
  wattsN4 Float
  wattsN5 Float
  wattsN6 Float

  fatorPotenciaN1 Float
  fatorPotenciaN2 Float
  fatorPotenciaN3 Float
  fatorPotenciaN4 Float
  fatorPotenciaN5 Float
  fatorPotenciaN6 Float

  capacitanciaN1 Float
  capacitanciaN2 Float
  capacitanciaN3 Float
  capacitanciaN4 Float
  capacitanciaN5 Float
  capacitanciaN6 Float

  componente   Componente @relation(fields: [componenteID], references: [id], onDelete: Cascade)
  componenteID Int        @unique

  equipamento Equipamento[]
}

model EnsaioFPBucha {
  id            Int   @id @default(autoincrement())
  corrente      Float
  watts         Float
  fatorPotencia Float
  capacitancia  Float

  componente   Componente @relation(fields: [componenteID], references: [id], onDelete: Cascade)
  componenteID Int        @unique

  equipamento Equipamento[]
}

model EnsaioCorrenteExcitacao {
  id           Int   @id @default(autoincrement())
  correnteH1H3 Float
  correnteH2H1 Float
  correnteH3H2 Float

  componente   Componente @relation(fields: [componenteID], references: [id], onDelete: Cascade)
  componenteID Int        @unique

  equipamento Equipamento[]
}

model Equipamento {
  id          Int    @id @default(autoincrement())
  nome        String
  descricao   String
  modelo      String
  numeroSerie String @unique

  // ensaioTrafoAlta      EnsaioTrafoAlta @relation(fields: [ensaioTrafoAlta], references: [id])
  // ensaioTrafoAltaId Int

  ensaioTrafoPotencia   EnsaioTrafoPotencia? @relation(fields: [ensaioTrafoPotenciaId], references: [id], onDelete: Cascade)
  ensaioTrafoPotenciaId Int?

  // ensaioTrafoForca      EnsaioTrafoForca @relation(fields: [ensaioTrafoForcaId], references: [id])
  // ensaioTrafoForcaId Int

  ensaioTrafoCorrente   EnsaioTrafoCorrente? @relation(fields: [ensaioTrafoCorrenteId], references: [id], onDelete: Cascade)
  ensaioTrafoCorrenteId Int?

  ensaioDisjuntor   EnsaioDisjuntor? @relation(fields: [ensaioDisjuntorId], references: [id], onDelete: Cascade)
  ensaioDisjuntorId Int?

  malhaAterramento      MalhaAterramento? @relation(fields: [malhaAterramentoSerie], references: [id], onDelete: Cascade)
  malhaAterramentoSerie Int?

  ensaioResistor              EnsaioResistorAterramento? @relation(fields: [EnsaioResistorAterramentoId], references: [id], onDelete: Cascade)
  EnsaioResistorAterramentoId Int?

  ensaioChaveSeccionadora   EnsaioChaveSeccionadora? @relation(fields: [ensaioChaveSeccionadoraId], references: [id], onDelete: Cascade)
  ensaioChaveSeccionadoraId Int?

  ensaioFPTrafo   EnsaioFPTrafo @relation(fields: [EnsaioFPTrafoId], references: [id], onDelete: Cascade)
  EnsaioFPTrafoId Int

  medicaoCaboMufla   MedicaoCaboMufla? @relation(fields: [medicaoCaboMuflaId], references: [id], onDelete: Cascade)
  medicaoCaboMuflaId Int

  ensaioFPBucha   EnsaioFPBucha? @relation(fields: [EnsaioFPBuchaId], references: [id], onDelete: Cascade)
  EnsaioFPBuchaId Int

  ensaioCorrenteExcitacao   EnsaioCorrenteExcitacao? @relation(fields: [ensaioCorrenteExcitacaoId], references: [id], onDelete: Cascade)
  ensaioCorrenteExcitacaoId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LogAtividade {
  id            Int      @id @default(autoincrement())
  acao          String // EXCLUIR, CRIAR, ATUALIZAR
  entidade      String // funcionario, ordem, componente etc.
  dadosAfetados Json // snapshot do que foi afetado
  feitoPor      Int // matrícula de quem realizou a ação
  criadoEm      DateTime @default(now())
}

model Recomendacao {
  id Int @id @default(autoincrement())

  componente   Componente? @relation(fields: [componenteId], references: [id])
  componenteId Int
  observacao   String

  subestacao   Subestacao @relation(fields: [subestacaoId], references: [id], onDelete: Cascade)
  subestacaoId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
